{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "title", "summary", "dishName", "dishServings", "logServings", "logDate", "eatenAt", "clarification", "foods", "notes"],
  "properties": {
    "intent": { "type": "string", "enum": ["log_foods", "create_recipe_and_log", "clarify"] },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "dishName": { "type": ["string", "null"] },
    "dishServings": { "type": "number", "exclusiveMinimum": 0 },
    "logServings": { "type": "number", "exclusiveMinimum": 0 },
    "logDate": { "type": ["string", "null"] },
    "eatenAt": { "type": ["string", "null"] },
    "clarification": { "type": ["string", "null"] },
    "foods": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "quantity", "unit", "gramsPerUnit", "caloriesPer100g", "proteinPer100g", "carbsPer100g", "fatPer100g", "confidence"],
        "properties": {
          "name": { "type": "string" },
          "brand": { "type": ["string", "null"] },
          "quantity": { "type": "number", "exclusiveMinimum": 0 },
          "unit": { "type": "string" },
          "gramsPerUnit": { "type": "number", "exclusiveMinimum": 0 },
          "caloriesPer100g": { "type": "number", "minimum": 0 },
          "proteinPer100g": { "type": "number", "minimum": 0 },
          "carbsPer100g": { "type": "number", "minimum": 0 },
          "fatPer100g": { "type": "number", "minimum": 0 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "sourceUrl": { "type": ["string", "null"] }
        }
      }
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 8
    }
  }
}
