{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": { "type": "string", "minLength": 20, "maxLength": 600 },
    "actions": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "type": "string", "minLength": 5, "maxLength": 240 } },
    "cautions": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "minLength": 5, "maxLength": 240 } }
  },
  "required": ["summary", "actions", "cautions"]
}
