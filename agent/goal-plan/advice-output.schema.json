{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "actions", "cautions", "meals"],
  "properties": {
    "summary": { "type": "string", "minLength": 1, "maxLength": 700 },
    "actions": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 220 } },
    "cautions": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "minLength": 1, "maxLength": 220 } },
    "meals": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "time", "foods"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 60 },
          "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
          "foods": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "type": "string", "minLength": 1, "maxLength": 140 } }
        }
      }
    }
  }
}
