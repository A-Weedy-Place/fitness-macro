# Required for every mobile-to-PC API request.
AGENT_PAIRING_TOKEN=replace-with-a-long-random-token
AGENT_HOST=0.0.0.0
AGENT_PORT=8787
AGENT_DATA_DIR=./data

# Optional nutrition source. Open Food Facts works without a key.
USDA_API_KEY=

# Free-tier Groq inference. Keep the account on the Free plan and do not add a
# payment method. One key can power both Whisper transcription and the app agent.
GROQ_API_KEY=
GROQ_AGENT_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_COMPLETION_TOKENS=2400
GROQ_MAX_CONTEXT_CHARS=10000

# Optional Strava OAuth integration.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://YOUR_PC_LAN_IP:8787/oauth/strava/callback
STRAVA_SCOPE=activity:read
