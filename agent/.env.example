# Required for every mobile-to-PC API request.
AGENT_PAIRING_TOKEN=replace-with-a-long-random-token
AGENT_HOST=0.0.0.0
AGENT_PORT=8787
AGENT_DATA_DIR=./data

# Optional nutrition source. Open Food Facts works without a key.
USDA_API_KEY=

# Optional local speech-to-text service.
# openai_compatible: server root or /v1/audio/transcriptions endpoint.
# whisper_cpp: whisper.cpp server root or /inference endpoint.
LOCAL_TRANSCRIBE_URL=http://127.0.0.1:8080
LOCAL_TRANSCRIBE_MODE=whisper_cpp
LOCAL_TRANSCRIBE_MODEL=whisper-1
LOCAL_TRANSCRIBE_KEY=

# Optional specialist Codex food resolver. It uses the logged-in Codex CLI.
CODEX_FOOD_RESOLVER_ENABLED=false
CODEX_GOAL_ADVISOR_ENABLED=false
CODEX_FOOD_SEARCH=false
CODEX_FOOD_TIMEOUT_SECONDS=75
CODEX_FOOD_MODEL=
CODEX_BIN=codex

# Optional Strava OAuth integration.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://YOUR_PC_LAN_IP:8787/oauth/strava/callback
STRAVA_SCOPE=activity:read
